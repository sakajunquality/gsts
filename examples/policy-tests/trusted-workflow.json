{
  "cases": [
    {
      "name": "trusted caller and reusable workflow",
      "expect": "allow",
      "claims": {
        "iss": "https://token.actions.githubusercontent.com",
        "sub": "repo:example-org/infra:ref:refs/heads/main",
        "aud": "https://gsts.example.com",
        "workflow_ref": "example-org/infra/.github/workflows/deploy.yml@refs/heads/main",
        "job_workflow_ref": "example-org/automation/.github/workflows/deploy.yml@refs/tags/v1"
      }
    },
    {
      "name": "different caller workflow file",
